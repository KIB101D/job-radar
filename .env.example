# Copy to .env for local development. Never commit the real .env.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# On Vercel the project's domains are added to both lists automatically
# (VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL). Only another domain needs these:
# CSRF_TRUSTED_ORIGINS=https://radar.example.com

# Leave empty for SQLite (db.sqlite3). In production: Neon Postgres URL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public address, used in bot messages and for the Telegram webhook.
SITE_URL=http://localhost:8000

# Telegram bot. Locally use a separate dev bot: run_bot_locally removes the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Pop-up toast about new vacancies on the radar page (on by default)
# NEW_VACANCIES_TOAST=True

# Polite fetching (optional overrides)
# FETCH_USER_AGENT=JobRadar/0.1 (+https://github.com/KIB101D/job-radar)
# FETCH_TIMEOUT_SECONDS=15
# FETCH_MAX_RETRIES=3
# FETCH_DELAY_BETWEEN_SOURCES_SECONDS=2
# check_active: pause between vacancy pages and max pages per run
# CHECK_ACTIVE_DELAY_SECONDS=1.5
# CHECK_ACTIVE_MAX_PER_RUN=300

# Logging and HTTPS (production)
# LOG_LEVEL=INFO
# SECURE_HSTS_SECONDS=2592000

# Run the test suite on Postgres instead of in-memory SQLite (CI does both)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobradar
