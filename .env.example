# Copy to .env for local development. Never commit the real .env.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://job-radar.onrender.com

# Leave empty for SQLite (db.sqlite3). In production: Neon Postgres URL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

SITE_URL=http://localhost:8000

# Telegram bot (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Pop-up toast about new vacancies (built, off by default)
# NEW_VACANCIES_TOAST=False

# Polite fetching (optional overrides)
# FETCH_USER_AGENT=JobRadar/0.1 (+https://github.com/KIB101D/job-radar)
# FETCH_TIMEOUT_SECONDS=15
# FETCH_MAX_RETRIES=3
# FETCH_DELAY_BETWEEN_SOURCES_SECONDS=2
